<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- English is the language the strings are written in, and the one used when
	     none of the reader's languages has a Resources/<code>.lproj. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleName</key>
	<string>Caliper</string>
	<key>CFBundleDisplayName</key>
	<string>Caliper</string>
	<key>CFBundleIdentifier</key>
	<string>de.alhaidari.caliper</string>
	<key>CFBundleExecutable</key>
	<string>Caliper</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Placeholders. A release build has both replaced by Tools/bundle.sh: the
	     version from the tag, the build number from the commit count on main,
	     which is what Sparkle compares. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- The last line of Finder's Get Info. -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Hossain Alhaidari</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Agent app: menu bar only, no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Sparkle. The feed is appcast.xml on the latest GitHub release, which the
	     release workflow attaches to every release. Tools/bundle.sh removes
	     SUFeedURL from any build it is not given a version for, so only a release
	     ever updates itself. SUPublicEDKey is written by `make update-key`; while
	     it is empty the updater stays off.
	     Automatic checks start on, as they always have in Caliper: one request a
	     day, switched off from the status item menu. That also stops Sparkle
	     asking about them on the second launch. The anonymous system profile is
	     never offered, and UpdateService allows no profile keys, so it stays empty
	     even if the defaults turn it on. -->
	<key>SUFeedURL</key>
	<string>https://github.com/hossainalhaidari/caliper/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>W+WYHcatOWuYaSUPIBduUj8mUZAB3rFSWl2HofwFv8Q=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>

	<!-- A registered type so a shared widget can be opened by double-clicking.
	     The contents are plain JSON and conform to public.json, so every other
	     tool still treats the file as text. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.alhaidari.caliper.widget</string>
			<key>UTTypeDescription</key>
			<string>Caliper Widget</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>caliperwidget</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Caliper Widget</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.alhaidari.caliper.widget</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
